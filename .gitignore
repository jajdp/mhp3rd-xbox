# Nothing that belongs to the game ever goes in here.

# ISOs and dumps
*.iso
*.cso
*.pbp
*.chd
*.parte*

# game data, mods and saves
datos/
mods/
*.sav
*.bin

# build output
*.exe
*.dll
*.lib
*.obj
*.pdb
*.msix
*.appx
build/
build-*/
contenido/
out/

# signing certificates: yours is yours
*.pfx
*.p12
*.cer

# logs
*.log
_registros/

# Python / editors / OS
__pycache__/
*.py[cod]
.venv/
venv/
.vs/
.vscode/
*.swp
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# The package tiles are supplied by whoever packages (docs/ASSETS.md).
package/Assets/*.png
